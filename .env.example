APP_PORT=18080

# Local API only: export DATABASE_PATH before starting uvicorn if needed.
# Compose always uses /app/data/date-wheel.sqlite3 in the sqlite_data volume.
# DATABASE_PATH=data/date-wheel.sqlite3

# Optional; backend only. Leave empty to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional single-admin auth; disabled until all values are valid. Backend only.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Exact external HTTPS origin, without trailing slash.
ADMIN_ORIGIN=https://date.benjiro.ir

# Optional history retention, bounded to 1–365 days (default 90).
HISTORY_RETENTION_DAYS=90
